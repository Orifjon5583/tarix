# ===================================================
# XOTIRALARIM - ENV KONFIGURATSIYASI
# Ushbu fayldan nusxa olib, .env.local nomi bilan saqlang
# va o'z kalitlaringizni kiriting.
# ===================================================

# Supabase loyihasi parametrlari
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role maxfiy kaliti (Faqat server-side, NEXT_PUBLIC_ prefiksi yo'q!)
# Admin tekshiruvi, avtomatlashtirilgan cron va xavfsiz server amallari uchun
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron API xavfsizlik kaliti (Vercel cron yoki tashqi webhook eslatmalar uchun)
CRON_SECRET=your-secure-cron-secret-token

# Web Push bildirishnomalari uchun VAPID kalitlari (ixtiyoriy)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@example.com

# Asosiy sayt URL manzili (ishlab chiqishda http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
